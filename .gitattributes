# Normalize text files to LF in the repo
* text=auto eol=lf

*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf

# Files the tools regenerate on Windows (data/bbox.json by tools/fetch_map_data.py, the
# *.import files by Godot and tools/build_osm_city.py): LF in the repo and in the working
# tree whatever core.autocrlf says, and the tools write LF, so a rebuild doesn't show up as
# line-ending-only changes.
data/bbox.json text eol=lf
*.import text eol=lf
*.gdignore text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.webp binary
*.svg text eol=lf
*.blend binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.exe binary
*.pck binary
*.glb binary
*.wasm binary
