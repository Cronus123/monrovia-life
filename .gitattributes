# Normalize text files to LF in the repo
* text=auto eol=lf

*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.webp binary
*.svg text eol=lf
*.blend binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.exe binary
*.pck binary
